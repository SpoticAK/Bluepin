# Environment identity. development = local (.env file), preview = bluepin-f8a09
# App Hosting backend, production = myhealthyfam App Hosting backend.
# On App Hosting this comes from apphosting.yaml, NOT from a file.
ENV_NAME=development

# Firebase Configuration (Overrides firebase-applet-config.json)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Web Push VAPID public key. Required for browser notifications (FCM Web) —
# getToken() fails without it. Generate a pair with:
#   npx web-push generate-vapid-keys
# Only the PUBLIC key belongs here; the private key is never needed by this app.
VITE_FIREBASE_VAPID_KEY=

# AI API Key
GEMINI_API_KEY=

# Frontend Variables
VITE_RECAPTCHA_SITE_KEY=

# Admin / referral dashboard access (comma-separated emails).
# Server-side lists authorize the API routes.
ADMIN_EMAILS=
REFERRAL_VIEWER_EMAILS=
# Client-side mirrors are baked in at build time and gate the dashboard tab.
# They must contain the same emails as their server counterparts, otherwise
# the tab either does not render or every request returns 403.
VITE_ADMIN_EMAILS=
VITE_REFERRAL_VIEWER_EMAILS=

# Canonical public app URL used when the dashboard copies a referral link.
# Falls back to window.location.origin when unset.
VITE_APP_URL=

# Email configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Meta WhatsApp Cloud API Configuration
# WHATSAPP_MODE=test uses the Meta TEST sender (preview/dev). =live is only
# allowed when ENV_NAME=production — anything else fails at boot.
WHATSAPP_MODE=test
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WABA_ID=
META_BASE_URL=https://graph.facebook.com/v26.0
WHATSAPP_VERIFY_TOKEN=bluepin_webhook_secret
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_PHONE=

# Approved template language. Must match the language the template was
# submitted in (e.g. en_US) or Meta returns 132001 "template does not exist
# in the translation".
WHATSAPP_TEMPLATE_LANG=en_US

# Name of an approved AUTHENTICATION template. Unset means one-time codes are
# sent as a plain service message, which Meta only delivers inside a 24-hour
# customer service window. See routes/whatsapp.ts.
WHATSAPP_OTP_TEMPLATE_NAME=

# HMAC secret for hashing one-time codes at rest. Falls back to
# WHATSAPP_APP_SECRET, then to a per-process random value.
OTP_SECRET=

# Public URL of the deployed frontend. Every "View health profile" CTA and every
# magic login link the bot sends resolves this, so all of them hand the user the
# same host. FRONTEND_URL is accepted as a fallback name, but APP_URL wins — set
# APP_URL. A wrong value here means tapping a link in WhatsApp lands nowhere.
APP_URL=

# Extra browser origins allowed to call the applicant referral endpoint only
# (comma-separated). Other API routes keep their previous permissive CORS
# behaviour. The built-in allowlist already includes bluepin.in,
# www.bluepin.in, app.bluepin.in, the preview host from APP_URL, and localhost
# outside production. Add preview or custom portal hosts here.
CORS_ALLOWED_ORIGINS=

# Lifetime of a single-use magic login link, in minutes. These authenticate a
# logged-out user straight into the dashboard, so keep this short. Defaults to
# 30 when unset.
WHATSAPP_MAGIC_TOKEN_TTL_MINUTES=30

# Media download tuning. The caller acknowledges the user before downloading,
# so a longer timeout costs nothing. Defaults are deliberately generous: a
# metadata GET /{media_id} that has not answered in 30s will not answer in 31s,
# and the per-attempt elapsed logs are there to reveal throttling rather than
# hide it behind an aggressive timeout.
#
# WHATSAPP_MEDIA_DOWNLOAD_TIMEOUT_MS covers headers AND body for one attempt.
# Measured throughput to Meta's media CDN has been as low as ~47 KB/s, so a
# 5 MB report needs ~110s. Keep this comfortably above that or legitimate
# reports near the cap will time out mid-transfer.
WHATSAPP_MEDIA_DOWNLOAD_TIMEOUT_MS=120000
WHATSAPP_MEDIA_METADATA_TIMEOUT_MS=30000
WHATSAPP_MEDIA_DOWNLOAD_ATTEMPTS=3
WHATSAPP_MEDIA_MAX_BYTES=5242880
